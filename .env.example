# AI Video Creator — Environment Variables
# Copy file này thành .env và điền API keys

# REQUIRED: Groq API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# REQUIRED: Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: ElevenLabs API Key (https://elevenlabs.io - free 10k chars/month)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OPTIONAL: ElevenLabs Voice ID (default: Sarah)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Server port (default: 3000)
PORT=3000
