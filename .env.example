# AI Video Creator — Environment Variables Example
# Copy file này thành .env và điền API keys của bạn

# REQUIRED: Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: ElevenLabs API Key (https://elevenlabs.io)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OPTIONAL: ElevenLabs Voice ID (default: Sarah)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# OPTIONAL: Jina Search API Key (https://jina.ai - for News Hunter mode)
JINA_API_KEY=your_jina_api_key_here

FIRECRAWL_API_KEY=your_firecrawl_api_key_here


# YouTube OAuth 2.0 (from Google Cloud Console)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# Server port (default: 3000)
PORT=3000
